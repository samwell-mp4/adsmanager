# Environment variables for Browser Manager

# Port for Backend API
PORT=3001
HOST=0.0.0.0

# Database Configuration (PostgreSQL)
# For Easypanel internal network:
DATABASE_URL=postgres://adsmanager:Samuca03146555%40@adsmanager_adsmanager:5432/adsmanager?sslmode=disable
# If testing from host/local machine:
# DATABASE_URL=postgres://adsmanager:Samuca03146555%40@localhost:5432/adsmanager?sslmode=disable

# Host path where profile volumes will be persisted
PROFILES_DATA_DIR=/data/browser-profiles

# Docker image name for profile containers
BROWSER_IMAGE=browser-profile:latest

# Port ranges for dynamic allocation
NOVNC_PORT_START=6100
NOVNC_PORT_END=6999
CDP_PORT_START=9200
CDP_PORT_END=9999
VNC_PORT_START=5901
VNC_PORT_END=6099

# Docker resource limits per profile
PROFILE_MEMORY_MB=1024
PROFILE_CPU_LIMIT=1.0

# Security / JWT secret (optional / ready for future auth)
JWT_SECRET=super-secret-browser-manager-key-change-in-production

# External URL prefix for reverse proxy (e.g., http://localhost:3001 or https://browser.meudominio.com)
PUBLIC_URL=http://localhost:3001
