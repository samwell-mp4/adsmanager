{
  "name": "browser-manager-root",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@browser-manager/web",
    "dev:web": "npm run dev --workspace=@browser-manager/web",
    "dev:api": "npm run dev --workspace=@browser-manager/api",
    "build:web": "npm run build --workspace=@browser-manager/web",
    "build:api": "npm run build --workspace=@browser-manager/api",
    "build": "npm run build:api",
    "start": "npm run start --workspace=@browser-manager/api"
  }
}
